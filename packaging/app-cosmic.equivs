Section: utils
Priority: optional
Standards-Version: 4.6.2

Package: app-cosmic
Version: 2.0.1
Maintainer: IdleScreen <jerydleuck@gmail.com>
# Note: the real payload package is built from Cargo.toml as app-cosmic
# (applet binary + these dependencies). This equivs file documents the
# product contract for the packages host.
Depends: idlescreen, idlescreen-savers
Recommends: idlescreen-cli, idlescreen-tui
Provides: idlescreen-applet, idlescreen-cosmic, trance-applet
Architecture: all
Description: IdleScreen for COSMIC Desktop (product)
 Installs IdleScreen daemon, all official savers, and the COSMIC applet.
