[Desktop Entry]
Name=IdleScreen
Comment=IdleScreen screensaver applet for COSMIC
Type=Application
Icon=io.github.idlescreen.CosmicApplet-symbolic
Exec=idlescreen-applet %F
Terminal=false
StartupNotify=true
Categories=COSMIC;System;Settings;
Keywords=COSMIC;IdleScreen;screensaver;
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
MimeType=
